VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Supabase (Project Settings -> API in your Supabase project)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only: used by api/places.js, never exposed to the browser (no VITE_ prefix)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Persona identity verification (challenge track - optional, see README "Persona").
# Both must be set for the "Verify with Persona" button to appear; leave blank to disable.
VITE_PERSONA_TEMPLATE_ID=itmpl_your_template_id
VITE_PERSONA_ENVIRONMENT_ID=env_your_environment_id
